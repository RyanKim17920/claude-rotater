{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "rota (TUI)",
            "type": "debugpy",
            "request": "launch",
            "module": "claude_rotater",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "console": "integratedTerminal"
        },
        {
            "name": "rota (custom args)",
            "type": "debugpy",
            "request": "launch",
            "module": "claude_rotater",
            "args": ["${input:cliArgs}"],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "cliArgs",
            "type": "promptString",
            "description": "CLI arguments (e.g., status, switch 2)"
        }
    ]
}
