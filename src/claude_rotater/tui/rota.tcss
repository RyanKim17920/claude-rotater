/* rota TUI: a quiet roster. One solid band on top (the header), open space
   below, and a key strip at the bottom with no chip backgrounds.
   Colors come from the registered rota-dark / rota-light themes (theme.py);
   this file only handles layout, spacing, and the few component states. */

Screen {
    background: $background;
}

/* -- main page ---------------------------------------------------------------- */

#status {
    height: 1;
    padding: 0 1;
    background: $surface;
}

#accounts {
    height: auto;
    margin-top: 1;
    max-height: 60%;  /* main.py lifts this to every row the page can spare */
    background: $background;
    padding: 0 1 0 0;
    scrollbar-size-vertical: 1;
}

#accounts:focus {
    background-tint: $foreground 0%;
}

#accounts ListItem {
    background: transparent;
    padding: 0 0 0 1;
}

/* One line per account at any width: the row lays itself out to fit and
   is cut, never wrapped, if it still runs over. */
#accounts ListItem Static {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* The row under the cursor: an accent-tinted band across the full width
   (plus the "›" glyph and a bold name drawn in main.py). The on-duty
   account has its own "●" mark, so cursor and duty never look alike. */
#accounts ListItem.-highlight,
#accounts:focus ListItem.-highlight {
    color: $foreground;
    background: $primary 14%;  /* theme.CURSOR_ALPHA */
    text-style: none;
}

#accounts ListItem:hover {
    background: $primary 7%;
}

/* As tall as its content: the charts (or the history view) fill every
   spare row, or are hidden when too few are spare. */
#detail {
    height: auto;
    padding: 0 1;
    margin-top: 1;
}

#event-log {
    height: 3;
    background: $background;
    padding: 0 1;
    scrollbar-size-vertical: 0;
}

/* The key strip sits on the bottom row, whatever the page above holds. */
#actions {
    dock: bottom;
    height: 1;
    margin-top: 1;
    padding: 0 1;
    background: $background;
}

/* Key strip: "l login  a add …", the key in the accent (markup in main.py),
   no chip fill so the bar reads as a legend, not a toolbar. */
#actions Button {
    border: none;
    height: 1;
    min-width: 0;
    width: auto;
    padding: 0;  /* Button's own line-pad leaves one cell each side */
    margin-right: 1;
    background: $background;
    color: $foreground;
    text-style: none;
}

#actions Button:hover {
    background: $surface;
}

/* -- modals ----------------------------------------------------------------- */

ConfirmModal, AddTokenModal, OutputModal, KeysModal {
    align: center middle;
    background: $background 60%;
}

.modal-box {
    width: 64;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    background: $surface;
    border: round $panel;
    padding: 1 2;
}

.modal-box-wide {
    width: 90;
}

.modal-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.modal-body {
    color: $foreground;
    margin-bottom: 1;
}

.modal-buttons {
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

/* Flat chip buttons: quiet at rest, terracotta block when focused. ←/→ move
   focus between them, Enter presses — the accent shows where Enter lands. */
.modal-buttons Button {
    border: none;
    height: 1;
    min-width: 12;
    padding: 0 2;
    margin-left: 2;
    background: $panel;
    color: $foreground;
    text-style: none;
}

.modal-buttons Button:hover {
    background: $panel-lighten-1;
}

.modal-buttons Button:focus {
    background: $primary;
    color: $background;
    text-style: bold;
}

.modal-hint {
    height: 1;
    margin-top: 1;
    color: $secondary;
}

.modal-output {
    height: auto;
    max-height: 20;
    background: $background;
    padding: 1;
}

.form-error {
    height: 1;
    color: $error;
}

AddTokenModal Input {
    margin-bottom: 1;
}
