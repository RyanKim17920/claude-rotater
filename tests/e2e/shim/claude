#!/usr/bin/env python3
"""Stand-in for ``claude`` during the staged-login E2E test.

``claude auth login`` needs a browser, so this one finishes the login the
way Claude Code 2.1.x stores it, without one: the credential goes into the
Keychain item named for ``CLAUDE_CONFIG_DIR`` (written through
``security -i`` with ``add-generic-password -U -a <user> -s <service> -X
<hex>``, as Claude Code does) and the identity into that profile's
``.claude.json``. Its flags are checked against the real binary's own
``claude auth login --help``, so a flag the real claude no longer takes
fails here too. Every other command goes to the real claude
(``$ROTA_E2E_REAL_CLAUDE``), so ``claude auth status`` is the real one
reading what this wrote.

The account to log in comes from ``$ROTA_E2E_LOGIN_CREDENTIAL`` and
``$ROTA_E2E_LOGIN_ACCOUNT`` (JSON). Each call is logged as a JSON line to
``$ROTA_E2E_SHIM_LOG``.
"""

import hashlib
import json
import os
import re
import subprocess
import sys
import unicodedata

REAL = os.environ["ROTA_E2E_REAL_CLAUDE"]


def log(entry):
    path = os.environ.get("ROTA_E2E_SHIM_LOG")
    if path:
        with open(path, "a") as f:
            f.write(json.dumps(entry) + "\n")


def service():
    raw = os.environ.get("CLAUDE_CONFIG_DIR")
    if not raw:
        return "Claude Code-credentials"
    digest = hashlib.sha256(unicodedata.normalize("NFC", raw).encode()).hexdigest()[:8]
    return f"Claude Code-credentials-{digest}"


def account_name():
    user = os.environ.get("USER") or "claude-code-user"
    return user if re.fullmatch(r"[a-zA-Z0-9._-]+", user) else "claude-code-user"


def accepted_login_flags():
    help_text = subprocess.run(
        [REAL, "auth", "login", "--help"], capture_output=True, text=True, timeout=30
    ).stdout
    flags = {}
    for line in help_text.splitlines():
        m = re.match(r"\s+(-\w, )?(--[\w-]+)( <\w+>)?", line)
        if m:
            flags[m.group(2)] = bool(m.group(3))
    return flags


def login(args):
    flags = accepted_login_flags()
    i = 0
    while i < len(args):
        arg = args[i]
        name = arg.split("=", 1)[0]
        if name not in flags:
            print(f"error: unknown option '{arg}'", file=sys.stderr)
            return 1
        i += 2 if flags[name] and "=" not in arg else 1
    credential = os.environ["ROTA_E2E_LOGIN_CREDENTIAL"]
    account = json.loads(os.environ["ROTA_E2E_LOGIN_ACCOUNT"])
    cmd = (
        f'add-generic-password -U -a "{account_name()}" -s "{service()}" '
        f"-X \"{credential.encode().hex()}\"\n"
    )
    result = subprocess.run(["/usr/bin/security", "-i"], input=cmd, capture_output=True, text=True)
    if result.returncode != 0:
        print(f"keychain write failed: {result.stderr}", file=sys.stderr)
        return 1
    base = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~")
    path = os.path.join(base, ".claude.json")
    try:
        with open(path) as f:
            cfg = json.load(f)
    except (OSError, ValueError):
        cfg = {}
    cfg["oauthAccount"] = account
    with open(path, "w") as f:
        json.dump(cfg, f, indent=2)
    print("Login successful.")
    return 0


def main():
    args = sys.argv[1:]
    log({"argv": args, "CLAUDE_CONFIG_DIR": os.environ.get("CLAUDE_CONFIG_DIR")})
    if args[:2] == ["auth", "login"] and "--help" not in args and "-h" not in args:
        return login(args[2:])
    os.execv(REAL, [REAL, *args])


if __name__ == "__main__":
    sys.exit(main())
